 0020           ;     UDR = c;
 0020 4CB9              out 0xc,R20
 0022                   .dbline 20
 0022           ;     return c;
 0022 042F              mov R16,R20
 0024 1127              clr R17
 0026                   .dbline -2
 0026           L1:
 0026                   .dbline 0 ; func end
 0026 4991              ld R20,y+
 0028 0895              ret
 002A                   .dbsym r c 20 c
 002A                   .dbend
