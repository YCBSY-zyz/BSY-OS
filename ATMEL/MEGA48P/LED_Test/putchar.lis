 0008 30900100          lds R3,__textmode+1
 000C 2220              tst R2
 000E 11F4              brne X0
 0010 3320              tst R3
 0012 21F0              breq L5
 0014           X0:
 0014 4A30              cpi R20,10
 0016 11F4              brne L5
 0018           X1:
 0018                   .dbline 16
 0018           ;         putchar('\r');
