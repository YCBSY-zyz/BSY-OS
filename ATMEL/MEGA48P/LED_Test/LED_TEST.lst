    00229 9613      ADIW	R26,3
    0022A 922D      ST	X+,R2
    0022B 923C      ST	X,R3
(0160) 	sp->pre->next = sp->next;       //要删除节点SP前面节点A的next指向后面节点B的地址
    0022C 8025      LDD	R2,Z+5
    0022D 8036      LDD	R3,Z+6
    0022E 81A3      LDD	R26,Z+3
    0022F 81B4      LDD	R27,Z+4
    00230 9615      ADIW	R26,5
    00231 922D      ST	X+,R2
    00232 923C      ST	X,R3
(0161) 	free(sp);                       //删除节点，释放内存
