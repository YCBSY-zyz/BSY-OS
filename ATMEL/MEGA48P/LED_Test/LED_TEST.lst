(0027) * 输入    : int len 系统开辟的内存堆大小
(0028) * 返回    : 无 
(0029) * 说明    : 1)、系统内核工作频率 / 1000Hz	1ms时间周期
(0030) *			
(0031) *******************************************************************************/
(0032) void Bsy_Os_Init(int len)
(0033) {
(0034) 	//内核时钟节拍为1MS，即1000Hz频率，用于任务状态切换及延时处理
(0035)     TCCR2A = 0x00;               //计数模式
    0011F 2422      CLR	R2
    00120 9220 00B0 STS	0xB0,R2
(0036)     TCCR2B = 0x04;               //64分频
    00122 E084      LDI	R24,4
    00123 9380 00B1 STS	0xB1,R24
(0037)     TCNT2 = 131; 			     //8000000/64/1000 = 125    256 - 125 = 131
    00125 E883      LDI	R24,0x83
    00126 9380 00B2 STS	0xB2,R24
(0038)     TIMSK2 = 0x01;               //溢出中断
    00128 E081      LDI	R24,1
    00129 9380 0070 STS	0x70,R24
(0039) 	//开辟堆内存，长度len （200）Byte
(0040) 	_NewHeap(&_bss_end + 1, &_bss_end + len + 1); 	// 200 bytes heap 
    0012B E68F      LDI	R24,0x6F
    0012C E091      LDI	R25,1
    0012D 0195      MOVW	R18,R10
    0012E 0F28      ADD	R18,R24
    0012F 1F39      ADC	R19,R25
    00130 E60F      LDI	R16,0x6F
    00131 E011      LDI	R17,1
    00132 D270      RCALL	__NewHeap
(0041) 		
(0042)     Task_Init();                                    //创建根节点           
    00133 D049      RCALL	_Task_Init
    00134 90B9      LD	R11,Y+
    00135 90A9      LD	R10,Y+
    00136 9508      RET
_Task_Schedule:
  sp                   --> R20
    00137 934A      ST	-Y,R20
    00138 935A      ST	-Y,R21
(0043) }
