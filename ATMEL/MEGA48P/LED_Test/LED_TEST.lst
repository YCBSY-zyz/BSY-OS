    002C4 9843      CBI	0x08,3
(0020) 		   led2_off;        //关闭led2
    002C5 9844      CBI	0x08,4
(0021) 	}
(0022) 	ledFlag = ~ledFlag;     //标识取反
    002C6 9020 0103 LDS	R2,ledFlag
    002C8 9420      COM	R2
    002C9 9220 0103 STS	ledFlag,R2
    002CB 9508      RET
(0023) }
