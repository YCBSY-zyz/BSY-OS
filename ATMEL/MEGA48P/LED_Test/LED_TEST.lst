(0186) /******************************************
(0187) *   任务中可变延时函数Task_Delay_ms
(0188) *   nms 延时时间多少ms
(0189) ******************************************/
(0190) /****************************
(0191) void Task_Delay_ms(uint nms){
(0192)     Stud_Type *sp;
(0193)     sp = root->next;
(0194)     
(0195)     while(sp){
(0196)         if(sp->id == cur_thread){       //找到对应的节点
(0197)             sp->task->NMS = nms;    	//改变该节点的延时时间
(0198)             break;
(0199)         }
(0200)         sp = sp->next;
(0201)     }
(0202) }
(0203) ***************************/
(0204) //延时函数
(0205) /******************
(0206) void  delay_ms(uint ms)
(0207) {
(0208)     delay_cnt = ms;   //设置延时值
(0209)     while(delay_cnt != 0);
(0210) }
